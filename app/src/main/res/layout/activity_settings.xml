<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paramètres LexOS"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- MODE JOUR / SOIR -->
        <TextView
            android:id="@+id/lblMode"
            style="@style/SettingLabel"
            android:text="MODE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnSoir"
                style="@style/ModeButton"
                android:text="Soir" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btnJour"
                style="@style/ModeButton"
                android:text="Jour" />
        </LinearLayout>

        <!-- COULEUR DES BOUTONS / ACCENT -->
        <TextView
            android:id="@+id/lblAccent"
            style="@style/SettingLabel"
            android:text="COULEUR DES BOUTONS" />

        <LinearLayout
            android:id="@+id/accentRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp" />

        <!-- COULEUR DU TEXTE -->
        <TextView
            android:id="@+id/lblText"
            style="@style/SettingLabel"
            android:text="COULEUR DU TEXTE" />

        <LinearLayout
            android:id="@+id/textRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp" />

        <!-- COULEUR DE FOND -->
        <TextView
            android:id="@+id/lblBg"
            style="@style/SettingLabel"
            android:text="COULEUR DE FOND" />

        <LinearLayout
            android:id="@+id/bgRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp" />

        <!-- PHOTO DE FOND -->
        <TextView
            android:id="@+id/lblWall"
            style="@style/SettingLabel"
            android:text="FOND D'ÉCRAN" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/btnPickImage"
                style="@style/ModeButton"
                android:text="Choisir une image" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btnClearImage"
                style="@style/ModeButton"
                android:text="Retirer" />
        </LinearLayout>

        <TextView
            android:id="@+id/lblDim"
            style="@style/SettingLabel"
            android:text="VOILE SOMBRE SUR LA PHOTO" />

        <SeekBar
            android:id="@+id/dimBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="80" />

        <!-- POLICE D'ECRITURE -->
        <TextView
            android:id="@+id/lblFont"
            style="@style/SettingLabel"
            android:text="POLICE D'ÉCRITURE" />

        <LinearLayout
            android:id="@+id/fontRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp" />

        <!-- EFFET MATRIX -->
        <TextView
            android:id="@+id/lblMatrix"
            style="@style/SettingLabel"
            android:text="EFFET MATRIX" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/btnMatrixOn"
                style="@style/ModeButton"
                android:text="Activé" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/btnMatrixOff"
                style="@style/ModeButton"
                android:text="Désactivé" />
        </LinearLayout>

        <!-- APERCU -->
        <TextView
            android:id="@+id/lblPreview"
            style="@style/SettingLabel"
            android:text="APERÇU" />

        <FrameLayout
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/previewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="LexOS"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/previewBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="14dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Bouton"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:text="Réinitialiser le thème"
            android:textColor="@color/lexos_grey_dim"
            android:textSize="14sp"
            android:padding="8dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
