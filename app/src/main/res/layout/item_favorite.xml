<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="36dp"
    android:paddingEnd="36dp">

    <FrameLayout
        android:id="@+id/favTile"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/tile_fav">

        <ImageView
            android:id="@+id/favIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/favName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/favLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="app favorite"
        android:textColor="@color/lexos_orange"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/favOpen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/logo_circle"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="Ouvrir"
        android:textColor="@color/lexos_black"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
